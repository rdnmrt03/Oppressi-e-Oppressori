[debug] [2026-09-27T15:04:06.719Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/oppressi-e-oppressori/rulesets {"name":"projects/oppressi-e-oppressori/rulesets/528a3367-d191-4464-9810-637baa4cff4e","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signed() { return request.auth != null; }\r\n    function room(code) { return get(/databases/$(database)/documents/ooRooms/$(code)).data; }\r\n    function host(code) { return signed() && room(code).hostId == request.auth.uid; }\r\n    function member(code) { return signed() && request.auth.uid in room(code).memberIds; }\r\n    match /ooRooms/{code} {\r\n      // Il codice casuale di 12 caratteri è l'invito. Nessun elenco pubblico delle stanze.\r\n      allow get: if signed();\r\n      allow list: if false;\r\n      allow create: if signed() && code.matches('^[A-HJ-NP-Z2-9]{12}$')\r\n        && request.resource.data.keys().hasOnly(['hostId','members','memberIds','n','town','phase','revision','game','hostSeen','createdAt'])\r\n        && request.resource.data.hostId == request.auth.uid\r\n        && request.resource.data.phase == 'lobby' && request.resource.data.revision == 0\r\n        && request.resource.data.game == null\r\n        && request.resource.data.n is int && request.resource.data.n >= 15 && request.resource.data.n <= 30\r\n        && request.resource.data.town is string && request.resource.data.town.size() <= 50\r\n        && request.resource.data.memberIds == [request.auth.uid]\r\n        && request.resource.data.members.size() == 1\r\n        && request.resource.data.members[0].keys().hasOnly(['uid','name'])\r\n        && request.resource.data.members[0].uid == request.auth.uid\r\n        && request.resource.data.members[0].name is string\r\n        && request.resource.data.members[0].name.size() > 0 && request.resource.data.members[0].name.size() <= 30\r\n        && request.resource.data.createdAt == request.time && request.resource.data.hostSeen == request.time;\r\n      allow update: if signed() && (\r\n        (resource.data.hostId == request.auth.uid && request.resource.data.hostId == resource.data.hostId)\r\n        || (resource.data.phase == 'lobby' && !(request.auth.uid in resource.data.memberIds)\r\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','memberIds','revision'])\r\n          && request.resource.data.revision == resource.data.revision + 1\r\n          && request.resource.data.members.size() == resource.data.members.size() + 1\r\n          && request.resource.data.members.size() <= resource.data.n\r\n          && request.resource.data.members[resource.data.members.size()].keys().hasOnly(['uid','name'])\r\n          && request.resource.data.members[resource.data.members.size()].uid == request.auth.uid\r\n          && request.resource.data.members[resource.data.members.size()].name is string\r\n          && request.resource.data.members[resource.data.members.size()].name.size() > 0\r\n          && request.resource.data.members[resource.data.members.size()].name.size() <= 30\r\n          && request.resource.data.members == resource.data.members.concat([request.resource.data.members[resource.data.members.size()]])\r\n          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])));\r\n      allow delete: if false;\r\n      match /private/{document} { allow read, write: if host(code); }\r\n      match /commands/{uid} {\r\n        allow read: if signed() && (request.auth.uid == uid || host(code));\r\n        allow create, update: if host(code) || (signed() && request.auth.uid == uid && member(code)\r\n          && room(code).phase == 'playing'\r\n          && request.resource.data.keys().hasOnly(['uid','action','value','revision','nonce','status','error','createdAt'])\r\n          && request.resource.data.uid == uid\r\n          && request.resource.data.action in ['place','daily','accuse','target','obey','redirect','intervene','pass','next','vote']\r\n          && (request.resource.data.value == null || request.resource.data.value is bool || request.resource.data.value is int || (request.resource.data.value is string && request.resource.data.value.size() <= 1500))\r\n          && request.resource.data.revision == room(code).revision\r\n          && request.resource.data.nonce is string && request.resource.data.nonce.size() <= 50\r\n          && request.resource.data.status == 'pending' && request.resource.data.error == ''\r\n          && request.resource.data.createdAt == request.time);\r\n        allow delete: if false;\r\n      }\r\n    }\r\n    match /{document=**} { allow read, write: if false; }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-09-27T15:04:08.228239Z","metadata":{"services":["cloud.firestore"]}}
